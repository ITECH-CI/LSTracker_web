<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

	<!--
		Recale les séquences d'identité des deux référentiels désormais
		administrables depuis l'interface (/sampletype, /samplerejectiontype).

		Contexte : ces tables sont alimentées par des chargements initiaux
		(sql/sample_type.sql puis sql/add_sample_type_01.sql ; loadData pour
		les motifs de rejet) qui fournissent l'id — soit explicitement, soit
		via l'ancienne séquence sample_type_id_seq, vestige d'avant le
		passage de la colonne en GENERATED BY DEFAULT AS IDENTITY.

		Dans les deux cas la séquence d'identité réellement utilisée par
		PostgreSQL n'avance pas. Conséquence : la première création par
		l'application (GenerationType.IDENTITY) réclame id=1, déjà pris :
		   ERROR: duplicate key value violates unique constraint "sample_type_pkey"

		Le problème est resté invisible tant que ces référentiels n'étaient
		pas administrables : les contrôleurs générés retournaient une vue
		vide et aucune création n'était possible depuis l'interface.

		Même approche que fix_sequences_after_loaddata.xml (region, district).
		`setval` est idempotent et les préconditions évitent tout rejeu.
	-->

	<changeSet id="fix-sample-type-sequence" author="pkomena">
		<preConditions onFail="MARK_RAN" onFailMessage="sample_type table missing">
			<tableExists tableName="sample_type" schemaName="sample_tracker"/>
		</preConditions>
		<sql dbms="postgresql">
			SELECT setval(
				pg_get_serial_sequence('sample_tracker.sample_type', 'id'),
				COALESCE((SELECT MAX(id) FROM sample_tracker.sample_type), 0) + 1,
				false
			);
		</sql>
	</changeSet>

	<changeSet id="fix-sample-rejection-type-sequence" author="pkomena">
		<preConditions onFail="MARK_RAN" onFailMessage="sample_rejection_type table missing">
			<tableExists tableName="sample_rejection_type" schemaName="sample_tracker"/>
		</preConditions>
		<sql dbms="postgresql">
			SELECT setval(
				pg_get_serial_sequence('sample_tracker.sample_rejection_type', 'id'),
				COALESCE((SELECT MAX(id) FROM sample_tracker.sample_rejection_type), 0) + 1,
				false
			);
		</sql>
	</changeSet>

</databaseChangeLog>
