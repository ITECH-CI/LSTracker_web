# Supervision LSTracker — copier en .env.monitoring (chmod 600, jamais commité).
# Compte PostgreSQL de supervision (rôle pg_monitor, lecture seule) :
# voir docs/SUPERVISION.md pour sa création.
PG_DEMO_DSN=postgresql://CHANGE_ME_monitoring:CHANGE_ME@tracker_db:5432/CHANGE_ME_db?sslmode=disable
PG_PROD_DSN=postgresql://CHANGE_ME_monitoring:CHANGE_ME@tracker_db:5432/CHANGE_ME_db?sslmode=disable
